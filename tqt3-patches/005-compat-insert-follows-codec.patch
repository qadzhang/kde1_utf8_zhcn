# KDE1 Revival Project 补丁 005
# 主题：Qt1 兼容字符串插入重载遵循 codecForCStrings（下拉框/列表框 CJK 字族名乱码根治）
#
# ┌─ What : TQComboBox::insertItem(const char*)/insertStrList 与
# │        TQListBox::insertItem(const char*)/insertStrList 六处
# │        TQString::fromLatin1(...) 改为 TQString::fromAscii(...)——
# │        fromAscii 在设置了 codecForCStrings 时按该 codec 解码
# │        （本项目全局为 UTF-8），未设置时行为与 fromLatin1 一致
# │  Why : Trinity 为兼容 Qt1 代码保留的 char* 重载把字节串硬按
# │        Latin-1 解码，本项目全局 UTF-8 语义下，中文等非 ASCII
# │        字符串（如控制中心字体页的 Noto CJK 本地化字族名）入表
# │        即成 Latin-1 乱码（用户 2026-09-01 截图实测）。与 002
# │        补丁同思路：Qt1 兼容语义须遵循 codecForCStrings
# │  Who : 一切经 char*/QStrList 向组合框、列表框插入文本的 KDE1 代码
# │        （kcmdisplay 字体页、kcmkfm 字体页、kfontdialog、kfontmanager等）
# │  When: 每次调用上述插入重载时
# │  Where: tqt3/src/widgets/qcombobox.cpp、tqt3/src/widgets/qlistbox.cpp
# │  How : fromLatin1 → fromAscii（qstring.h：fromAscii 无 codec 时
# │        即 fromLatin1，纯 ASCII 路径行为零变化）
# └────────────────────────────────────────────────────────────
#
# 操作：build.sh 在建立 tqt3-build/ 时按文件名序自动打入本补丁；
#       已有构建树可 (cd tqt3-build && patch -p1 --forward < 本文件) 增量重编。
--- a/src/widgets/qcombobox.cpp
+++ b/src/widgets/qcombobox.cpp
@@ -661,9 +661,9 @@
     while ( (tmp=it.current()) ) {
 	++it;
 	if ( d->usingListBox() )
-	    d->listBox()->insertItem( TQString::fromLatin1(tmp), index );
+	    d->listBox()->insertItem( TQString::fromAscii(tmp), index );
 	else
-	    d->popup()->insertItem( escapedComboString(TQString::fromLatin1(tmp)), index, index );
+	    d->popup()->insertItem( escapedComboString(TQString::fromAscii(tmp)), index, index );
 	if ( index++ == d->current && d->current < count() ) {
 	    if ( d->ed ) {
 		d->ed->setText( text( d->current ) );
@@ -736,9 +736,9 @@
     int i = 0;
     while ( (numStrings<0 && strings[i]!=0) || i<numStrings ) {
 	if ( d->usingListBox() )
-	    d->listBox()->insertItem( TQString::fromLatin1(strings[i]), index );
+	    d->listBox()->insertItem( TQString::fromAscii(strings[i]), index );
 	else
-	    d->popup()->insertItem( escapedComboString(TQString::fromLatin1(strings[i])), index, index );
+	    d->popup()->insertItem( escapedComboString(TQString::fromAscii(strings[i])), index, index );
 	i++;
 	if ( index++ == d->current && d->current < count()  ) {
 	    if ( d->ed ) {
--- a/src/widgets/qlistbox.cpp
+++ b/src/widgets/qlistbox.cpp
@@ -1368,7 +1368,7 @@
 	index = count();
     while ( (txt=it.current()) ) {
 	++it;
-	insertItem( new TQListBoxText(TQString::fromLatin1(txt)),
+	insertItem( new TQListBoxText(TQString::fromAscii(txt)),
 		    index++ );
     }
     if ( hasFocus() && !d->current )
@@ -1410,7 +1410,7 @@
 	index = count();
     int i = 0;
     while ( (numStrings<0 && strings[i]!=0) || i<numStrings ) {
-	insertItem( new TQListBoxText( TQString::fromLatin1(strings[i])),
+	insertItem( new TQListBoxText( TQString::fromAscii(strings[i])),
 		    index + i );
 	i++;
     }
