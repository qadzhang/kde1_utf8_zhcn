+	// was: XChangeWindowAttributes(... CWOverrideRedirect | CWSaveUnder ...)
+	XChangeWindowAttributes( dpy, id, CWOverrideRedirect,
 				 &wsa );
 	XClassHint class_hint;
 	class_hint.res_name = (char *) tqAppName(); // application name
