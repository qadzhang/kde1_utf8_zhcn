#: gameboard.cc:55
msgid "End Turn"
msgstr "结束回合"

#: gameboard.cc:203
msgid ": Select source planet..."
msgstr ": 请选择出发星球..."

#: gameboard.cc:221
msgid ": Select destination planet..."
msgstr ": 请选择目标星球..."

#: gameboard.cc:243
msgid ": How many ships?"
msgstr ": 派遣多少艘飞船?"

#: gameboard.cc:267
msgid "Ruler: Select starting planet."
msgstr "标尺: 请选择起始星球。"

#: gameboard.cc:287
#, c-format
msgid ""
"The distance from Planet %s to Planet %s is %s light years.\n"
"A ship leaving this turn will arrive on turn %s"
msgstr ""
"星球 %s 到星球 %s 的距离为 %s 光年。\n"
"本回合出发的飞船将于第 %s 回合抵达"

#: gameboard.cc:291
msgid "Distance"
msgstr "距离"

#: gameboard.cc:296
msgid "Ruler: Select ending planet."
msgstr "标尺: 请选择终点星球。"

#: gameboard.cc:311
#, c-format
msgid "Turn #: %2d of %2d"
msgstr "回合#: 第 %2d 回合,共 %2d 回合"

#: gameboard.cc:426
#, c-format
msgid "The once mighty empire of %s has fallen in ruins."
msgstr "曾经强盛的 %s 帝国已经覆灭。"

#: gameboard.cc:428
msgid "An Empire has fallen..."
msgstr "一个帝国覆灭了..."

#: gameboard.cc:438
#, c-format
msgid "The fallen empire of %s has staggered back to life."
msgstr "覆灭的 %s 帝国又摇摇欲坠地复活了。"

#: gameboard.cc:440
msgid "Up from the ashes..."
msgstr "从灰烬中重生..."

#: gameboard.cc:460
#, c-format
msgid "Reinforcements have arrived for planet %s"
msgstr "星球 %s 的增援已到达"

#: gameboard.cc:462
msgid "Fleet Arrival"
msgstr "舰队抵达"

#: gameboard.cc:505
#, c-format
msgid "Planet %s has held against an attack from %s"
msgstr "星球 %s 顶住了来自 %s 的进攻"

#: gameboard.cc:507
msgid "Planet Holds"
msgstr "星球守住了"

#: gameboard.cc:515
#, c-format
msgid "Planet %s has fallen to %s"
msgstr "星球 %s 已落入 %s 之手"

#: gameboard.cc:517
msgid "Planet Conquered"
msgstr "星球被征服"

#: gameboard.cc:579 mainwin.cc:82
msgid "End Game"
msgstr "结束游戏"

#: gameboard.cc:580
msgid "Do you wish to retire this game?"
msgstr "您要退出这局游戏吗?"

#: gameboard.cc:581 gameenddlg.cc:20
msgid "Yes"
msgstr "是"

#: gameboard.cc:581
msgid "Cancel"
msgstr "取消"

#: gameboard.cc:586
msgid "Final Standings"
msgstr "最终排名"

#: gameboard.cc:758
msgid "Error"
msgstr "错误"

#: gameboard.cc:758
msgid "Not enough ships to send."
msgstr "没有足够的飞船可派遣。"

#: gameenddlg.cc:14
msgid ""
"This is the last turn.\n"
"Do you wish to add more turns?"
msgstr ""
"这是最后一个回合。\n"
"要增加更多回合吗?"

#: gameenddlg.cc:24
msgid "No"
msgstr "否"

#: gameenddlg.cc:64
#, c-format
msgid "Add %d turns"
msgstr "增加 %d 个回合"

#: mainwin.cc:23
