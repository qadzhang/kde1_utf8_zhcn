#: main.cpp:72
msgid "&Standard shortcuts"
msgstr "&Standardowe skróty"

#: main.cpp:80
msgid "&Global shortcuts"
msgstr "&Ogólne skróty"

#: main.cpp:88
msgid "usage: kcmkeys [-init | {standard,global}]\n"
msgstr "użycie: kcmkeys [-init | {standard,global}]\n"

#: main.cpp:132
msgid "Key binding settings"
msgstr "Przypisania klawiszy"

#: keyconfig.cpp:106
msgid "Current scheme"
msgstr "Bieżący schemat"

#: keyconfig.cpp:108
msgid "KDE default"
msgstr "KDE domyślne"

#: keyconfig.cpp:115
msgid "&Key scheme"
msgstr "&Schemat klawiszy"

#: keyconfig.cpp:126
msgid "&Add ..."
msgstr "&Dodaj..."

#: keyconfig.cpp:148
msgid "&Save changes"
msgstr "&Zapisz zmiany"

#: keyconfig.cpp:211
msgid "Error removing scheme"
msgstr "Błąd usunięcia schematu"

#: keyconfig.cpp:212
msgid ""
"This key scheme could not be removed.\n"
"Perhaps you do not have permission to alter the file\n"
"system where the key scheme is stored."
msgstr ""
"Ten schemat klawiszy nie może zostać usunięty.\n"
"Prawdopodobnie nie masz praw do pliku systemowego,\n"
"w którym przechowywane są schematy kolorów."

#: keyconfig.cpp:343
msgid "Naming conflict"
msgstr "Konflikt nazw"

#: keyconfig.cpp:344
msgid ""
"Please choose a unique name for the new key\n"
"scheme. The one you entered already appears\n"
"in the key scheme list."
msgstr ""
"Proszę wybrać unikalną nazwę dla nowego schematu\n"
"klawiszy. Aktualnie wybrana nazwa już jest wprowadzona\n"
"do listy schematów klawiszy."

#: savescm.cpp:18
msgid "Add a key scheme"
msgstr "Dodaj schemat klawiszy"

#: savescm.cpp:32
msgid ""
"&Enter a name for the new key scheme\n"
"to be added to your personal list.\n"
"\n"
"The keys currently used in the preview will\n"
"be copied into this scheme to begin with."
msgstr ""
"&Wprowadź nazwę dla nowego schematu klawiszy,\n"
"aby dodać go do prywatnej listy.\n"
"\n"
"Klawisze, które widzisz w zapowiedzi, zostaną\n"
"skopiowane do tego schematu."

