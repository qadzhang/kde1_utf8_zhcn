#: main.cpp:72
msgid "&Standard shortcuts"
msgstr "Standardní &zkratky"

#: main.cpp:80
msgid "&Global shortcuts"
msgstr "&Globální zkratky"

#: main.cpp:88
msgid "usage: kcmkeys [-init | {standard,global}]\n"
msgstr "Použití: kcmkeys [-init | {standard,global}]\n"

#: main.cpp:132
msgid "Key binding settings"
msgstr "Nastavení klávesových vazeb"

#: keyconfig.cpp:106
msgid "Current scheme"
msgstr "Současné schéma"

#: keyconfig.cpp:108
msgid "KDE default"
msgstr "KDE implicitní"

#: keyconfig.cpp:115
msgid "&Key scheme"
msgstr "Schéma &kláves"

#: keyconfig.cpp:126
msgid "&Add ..."
msgstr "Přid&at ..."

#: keyconfig.cpp:148
msgid "&Save changes"
msgstr "&Uložit změny"

#: keyconfig.cpp:211
msgid "Error removing scheme"
msgstr "Chyba při rušení schématu"

#: keyconfig.cpp:212
msgid ""
"This key scheme could not be removed.\n"
"Perhaps you do not have permission to alter the file\n"
"system where the key scheme is stored."
msgstr ""
"Toto schéma kláves nemuže býy zrušené.\n"
"Pravděpodobně nemáte přístup k souboru, kde je\n"
"schéma uložené."

#: keyconfig.cpp:343
msgid "Naming conflict"
msgstr "Konflikt jmen"

#: keyconfig.cpp:344
msgid ""
"Please choose a unique name for the new key\n"
"scheme. The one you entered already appears\n"
"in the key scheme list."
msgstr ""
"Prosím zvolte si unikátní jméno pro nové\n"
"schéma kláves. Vámi zadané jméno je již\n"
"na seznamu schémat."

#: savescm.cpp:18
msgid "Add a key scheme"
msgstr "Přidávám schéma"

#: savescm.cpp:32
msgid ""
"&Enter a name for the new key scheme\n"
"to be added to your personal list.\n"
"\n"
"The keys currently used in the preview will\n"
"be copied into this scheme to begin with."
msgstr ""
"&Zadejte jméno pro nové schéma, která má\n"
"být přidána do vašeho osobního seznamu.\n"
"\n"
"Klávesy použité v náhledu budou do tohoto\n"
"schématu zkopírované."

