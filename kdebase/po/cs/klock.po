"\n"
"prosím nepoužívejte -test společně s -lock.\n"
"použijte místo toho klock.\n"
"\n"

#: main.cpp:664
#, c-format
msgid ""
"Usage: %s -install|-setup|-test|-desc|-preview wid|-inroot\n"
"       [-corners xxxx] [-delay num] [-lock] [-allow-root] [-nice num]\n"
msgstr ""
"Použití: %s -install|-setup|-test|-desc|-preview wid|-inroot\n"
"         [-corners xxxx] [-delay num] [-lock] [-allow-root] [-nice num]\n"

#: main.cpp:667
msgid ""
"  -corners xxxx     Placing cursor in corner performs action:\n"
"                     x = i  no action (ignore)\n"
"                     x = s  save screen\n"
"                     x = l  lock screen\n"
"                    order: top-left, top-right, bottom-left, bottom-right\n"
"  -delay num        Amount of idle time before screen saver\n"
"                     starts  (default 10min)\n"
"  -desc             Print the screen saver's description to stdout\n"
"  -install          Install screen saver\n"
"  -lock             Require password to stop screen saver\n"
"  -allow-root       Accept root password to unlock\n"
"  -nice num         Run with specified nice value\n"
"\n"
"  -preview wid      Run in the specified XWindow\n"
"  -inroot           Run in the root window\n"
"  -setup            Setup screen saver\n"
"  -test             Invoke the screen saver immediately\n"
msgstr ""
"  -corners xxxx     Umístění kurzoru do rohu provede akci:\n"
"                      x = i  žádná akce (ignoruj)\n"
"                      x = s  šetři obrazovku\n"
"                      x = l  uzamkni obrazovku\n"
"                     pořadí: horní-levý, horní-pravý, dolní-levý, "
"dolní-pravý\n"
"  -delay num        Doba nečinnosti před spuštěním šetřiče obrazovky\n"
"                    (implicitně 10min)\n"
"  -desc             Vypiš popis šetřiče obrazovky na stdout\n"
"  -install          Nainstaluj šetřič obrazovky\n"
"  -lock             Vyžaduj heslo na ukončení šetřiče obrazovky\n"
"  -allow-root       akceptovat heslo superuživatele k odemknutí\n"
"  -nice num         Proveď se specifikovanou hodnotou nice\n"
"\n"
"  -preview wid      Proveď ve specifikovaném X okně\n"
"  -inroot           Proveď v kořenovém okně\n"
"  -setup            Nastav šetřič obrazovky\n"
"  -test             Vyvolat okamžitě šetřič obrazovky\n"

