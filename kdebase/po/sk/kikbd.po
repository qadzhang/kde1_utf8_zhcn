#: kikbd.cpp:124
msgid "KDE International Keyboard already started on this display."
msgstr "KDE Medzinárodná klávesnica bola už na tomto displayi spustená."

#: kikbd.cpp:295
#, c-format
msgid ""
"X codes \"%s\" file does not exist.\n"
"Using X default codes."
msgstr ""
"Súbor s X kódmi \"%s\" neexistuje.\n"
"Používam štandardné X kódy."

#: kikbd.cpp:321
#, c-format
msgid ""
"Keyboard map \"%s\" does not exists.\n"
"Skipping this map."
msgstr ""
"Klávesová mapa \"%s\" neexistuje.\n"
"Vynechávam ju."

#: kikbd.cpp:337
msgid "Setup"
msgstr "Nastavenie"

#: kikbd.cpp:359 kikbd.cpp:372
#, c-format
msgid "Can not remove %s from Modifiers.\n"
msgstr "Nemôžem zrušiť %s z modifikátorov.\n"

#: kikbd.cpp:362
#, c-format
msgid "Can not add %s to Modifier number 3.\n"
msgstr "Nemôžem pridať %s k modifikátoru čislo 3.\n"

#: kikbd.cpp:384
#, c-format
msgid ""
"Can not set Mode Switch as %s for keyboard %s.\n"
"Alt symbols disabled"
msgstr ""
"Nemôžem nastaviť prepínač režimu ako %s pre klávesnicu %s.\n"
"Alt symboly zakázané"

#: kikbd.cpp:406
msgid ""
"Can't remove Caps Lock from Modifiers.\n"
"Caps Lock Emulation disabled"
msgstr ""
"Nemôžem zrušiť Caps Lock z modifikátorov.\n"
"Emulácia Caps Locku zakázaná"

#: kikbd.cpp:1097
msgid "Exiting International Keyboard"
msgstr "Ukončujem medzinárodnú klávesnicu"

#: kikbd.cpp:1098
msgid ""
"You're about to quit the \"International Keyboard\" tool.\n"
" Do you want to have it autostarted at your next login?"
msgstr ""
"Práve chcete ukončiť \"Medzinárodnú Klávesnicu\".\n"
" Chcete, aby sa automaticky spustil pri vašom ďalšom nahlásení?"

#: keymap.cpp:186
msgid "KeyMap: can't allocate memory"
msgstr "KeyMap: nemôžem alokovať pamäť"

#: keymap.cpp:233
#, c-format
msgid ""
"Can't find symbol \"%s\".\n"
"Maybe your default X codes do not match.\n"
"You can preset X codes from section \"Advanced\"\n"
"in the configuration program."
msgstr ""
"Nemôžem nájsť symbol \"%s\".\n"
"Možno sa vaše štandardné X kódy nezhodujú.\n"
"Môžete prednastaviť X kódy v sekcii \"Rozšírené\"\n"
"konfiguračného programu."

#: keymap.cpp:238
#, c-format
msgid "KeyMap: can't find symbol \"%s\"."
msgstr "KeyMap: nemôžem nájsť symbol \"%s\"."

#: keymap.cpp:246
#, c-format
msgid "KeyMap: can't read keycode \"%s\"."
msgstr "KeyMap: nerozumiem kódu klávesy \"%s\"."

#: keymap.cpp:252
#, c-format
msgid "KeyMap: keycode \"%s\" is out of range."
msgstr "KeyMap: kód klávesy \"%s\" je mimo rozsahu."

