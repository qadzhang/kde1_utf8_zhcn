#: widgets.cpp:475
msgid "&Emulate Caps Lock"
msgstr "&Emulovať CapsLock"

#: widgets.cpp:476
msgid ""
"Emulate XServer Caps Lock. Needed for correct keyboard operation in some "
"languages"
msgstr ""
"Emulovať XServer Caps Lock. Potrebné pre niektoré jazyky v niektorých "
"jazykoch"

#: widgets.cpp:482
msgid "&World Menu"
msgstr "&Svetové menu"

#: widgets.cpp:483
msgid "Show menu in any window by holding sown the selected Switch key(s)"
msgstr "Ukázať menu v akomkoľvek okne pri držaní prep. kláves"

#: widgets.cpp:491
msgid "&Save Classes"
msgstr "&Uložiť triedy"

#: widgets.cpp:492
