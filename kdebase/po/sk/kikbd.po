msgstr "Definovať X kódy"

#: widgets.cpp:501
msgid "Input"
msgstr "Vstup"

#: widgets.cpp:505
msgid "Standard behavior. Keyboard map effective for all windows"
msgstr "Štandardné správanie sa. Kláves. mapy aktívne pre všetky okná"

#: widgets.cpp:509
msgid ""
"Extended behavior. Keyboard map state is saved for each window independently"
msgstr ""
"Rozšírené správanie sa. Kláves. mapy sa ukladajú pre každé okno osobitne"

#: widgets.cpp:513
msgid ""
"Special behavior. Keyboard state is saved for each window class independently"
msgstr ""
"Špeciálne správanie sa. Kláves. mapy sa ukladajú pre každú triedu okien "
"osobitne"

