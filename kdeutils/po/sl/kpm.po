msgstr "SIGTSTP (stoj od tty)"

#: qps.C:321
msgid "SIGTTIN (tty input)"
msgstr "SIGTTIN (tty vhod)"

#: qps.C:322
msgid "SIGTTOU (tty output)"
msgstr "SIGTTOU (tty izhod)"

#: qps.C:622
#, c-format
msgid ""
"You do not have permission to view the\n"
"open sockets of process %d (%s).\n"
"Only the owner of the process and the\n"
"super-user may do that."
msgstr ""
"Nimate dovoljenja za ogled odprtih\n"
"vtičnic procesa %d (%s).\n"
"To lahko storita le lastnik procesa\n"
"in superuporabnik."

#: qps.C:627 qps.C:836 qps.C:878 qps.C:884 qps.C:907 qps.C:943 qps.C:987
msgid "Permission denied"
msgstr "Zavrnjeno dovoljenje"

#: qps.C:700
msgid "qps: change update period"
msgstr "qps: spremeni periodo obnavljanja"

#: qps.C:701
msgid "New update period:"
msgstr "Nova perioda obnavljanja:"

#: qps.C:716 qps.C:855 scheddlg.C:113
msgid "Invalid input"
msgstr "Nepravilen vnos"

#: qps.C:717
msgid ""
"The time between updates should be a number, optionally followed\n"
"by a unit (ms, s or min). If no unit is given, seconds is assumed."
msgstr ""
"Čas med obnovitvami mora biti število, kot opcijo lahko ima\n"
"enoto (ms, s ali min). Če enota ni podana, privzamem sekunde."

#: qps.C:831
#, c-format
msgid ""
"You do not have permission to renice the\n"
"selected process%s.\n"
"Only the process owner and the super-user\n"
"are allowed to do that."
msgstr ""
"Nimate dovoljenja, da bi uporabili ukaz renice\n"
"na izbranem procesu %s.\n"
"To lahko storita le lastnik procesa in superuporabnik."

#: qps.C:845
msgid "qps: renice process"
msgstr "qps: renice proces"

#: qps.C:846
msgid "New nice value:"
msgstr "Nova vrednost nice:"

#: qps.C:856
msgid ""
"The nice value should be\n"
"in the range -20 to 20."
msgstr ""
"Vrednost nice mora ležati\n"
"med -20 in 20."

#: qps.C:873
#, c-format
msgid ""
"You do not have permission to renice process %d (%s).\n"
"Only the process owner and the super-user are allowed to do that."
msgstr ""
"Nimate dovoljenja, da bi uporabili ukaz renice na procesu\n"
"%d (%s).\n"
"To lahko storita le lastnik procesa in superuporabnik."

#: qps.C:885
msgid "Only the super-user may lower the nice value of a process."
msgstr "Le superuporabnik lahko zniža procesu vrednost nice."

#: qps.C:908
msgid ""
"Only the super-user may change the\n"
"scheduling policy and static priority."
msgstr ""
"Le superuporabnik lahko spremeni\n"
"razporejevalno politiko in statično prioriteto."

#: qps.C:938
#, c-format
msgid ""
"You do not have permission to change the\n"
"scheduling and/or priority of process %d (%s).\n"
"Only the super-user may do that."
msgstr ""
"Nimate dovoljenja, da bi spremenili razporejanje\n"
"in/ali prioriteto procesa %d (%s).\n"
"To lahko stori le superuporabnik."

#: qps.C:982
#, c-format
msgid ""
"You do not have permission to send a signal to process %d (%s).\n"
"Only the super-user and the owner of the process may send signals to it."
msgstr ""
"Nimate dovoljenja, da bi poslali signal procesu %d (%s).\n"
"To lahko storita le lastnik procesa in superuporabnik."

