#: scheddlg.C:67
msgid "Priority (1-99):"
msgstr "Prioriteta (1-99):"

#: scheddlg.C:114
msgid "The priority must be in the range 1..99"
msgstr "Prioriteta mora ležati v obsegu 1..99"
