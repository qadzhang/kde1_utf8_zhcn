#: klpqspooler.cpp:199 klpqspooler.cpp:269
msgid "Can't find your lpc program !"
msgstr "Nie można znaleźć programu lpc!"

#: klpqspooler.cpp:200 klpqspooler.cpp:270
msgid ""
"Sorry, I can't find your lpc program.\n"
"Please check the configuration under Config->Spooler."
msgstr ""
"Nie można znaleźć programu lpc.\n"
"Sprawdź konfigurację w opcji menu Konfiguruj->System drukowania."

#: FirstStart.cpp:21 SpoolerConfig.cpp:21 SpoolerConfigData.cpp:151
msgid "Select your spooling system"
msgstr "Wybierz swój system obsługi drukowania"

#: FirstStartData.cpp:42
msgid ""
"Please select the spooling system you use. Most systems use the BSD spooler. "
"So if you don't know which spooler is installed on your system, BSD is "
"probably a good choice."
msgstr ""
"Proszę wybrać system obsługi drukowania. Większość systemów jest obsługiwana "
"przez BSD spooler. Jeżeli nie ma pewności co do zainstalowanego systemu "
"drukowania, najpewniej będzie to BSD."

