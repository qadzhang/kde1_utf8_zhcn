msgstr "&Sygnał"

#: qps.C:308
msgid "SIGQUIT (quit)"
msgstr "SIGQUIT (wyjście)"

#: qps.C:309
msgid "SIGILL (illegal instruction)"
msgstr "SIGILL (niedozwolona instrukcja)"

#: qps.C:310
msgid "SIGABRT (abort)"
msgstr "SIGABRT (załamanie)"

#: qps.C:311
msgid "SIGFPE (floating point exception)"
msgstr "SIGFPE (wyjątek zmiennoprzecinkowy)"

#: qps.C:312
msgid "SIGSEGV (segmentation violation)"
msgstr "SIGSEGV (błąd segmentacji)"

#: qps.C:313
msgid "SIGPIPE (broken pipe)"
msgstr "SIGPIPE (przerwany potok)"

#: qps.C:314
msgid "SIGALRM (timer signal)"
msgstr "SIGALRM (sygnał zegara)"

#: qps.C:315
msgid "SIGUSR1 (user-defined 1)"
msgstr "SIGUSR1 (użytkownika 1)"

#: qps.C:316
msgid "SIGUSR2 (user-defined 2)"
msgstr "SIGUSR2 (użytkownika 2)"

#: qps.C:317
msgid "SIGCHLD (child death)"
msgstr "SIGCHLD (potomek umarł)"

#: qps.C:318
msgid "SIGCONT (continue)"
msgstr "SIGCONT (kontynuacja)"

#: qps.C:319
msgid "SIGSTOP (stop)"
msgstr "SIGSTOP (zatrzymanie)"

#: qps.C:320
msgid "SIGTSTP (stop from tty)"
msgstr "SIGTSTP (zatrzymanie terminala)"

#: qps.C:321
msgid "SIGTTIN (tty input)"
msgstr "SIGTTIN (wejście z terminala)"

#: qps.C:322
msgid "SIGTTOU (tty output)"
msgstr "SIGTTOU (wyjście z terminala)"

#: qps.C:622
#, c-format
msgid ""
"You do not have permission to view the\n"
"open sockets of process %d (%s).\n"
"Only the owner of the process and the\n"
"super-user may do that."
msgstr ""
"Brak praw do wyświetlenia otwartych gniazdek\n"
"procesu %d (%s).\n"
"Tylko właściciel procesu oraz superużytkownik\n"
"mają do tego prawo."

#: qps.C:627 qps.C:836 qps.C:878 qps.C:884 qps.C:907 qps.C:943 qps.C:987
msgid "Permission denied"
msgstr "Brak praw dostępu!"

#: qps.C:700
msgid "qps: change update period"
msgstr "qps: zmień częstość odświeżania"

#: qps.C:701
msgid "New update period:"
msgstr "Nowa częstość odświeżania:"

#: qps.C:716 qps.C:855 scheddlg.C:113
msgid "Invalid input"
msgstr "Niepoprawny parametr"

#: qps.C:717
msgid ""
"The time between updates should be a number, optionally followed\n"
"by a unit (ms, s or min). If no unit is given, seconds is assumed."
msgstr ""
"Czas odświeżania musi być liczbą. Dodatkowo można określić\n"
"jednostkę czasu (ms, s lub min). Domyślną jednostką jest sekunda."

#: qps.C:831
#, c-format
#~ msgid ""
#~ "You do not have permission to renice the\n"
#~ "selected process%s.\n"
#~ "Only the process owner and the super-user\n"
#~ "are allowed to do that."
#~ msgstr ""
#~ "Brak praw do zmiany priorytetu\n"
#~ "procesu %d (%s).\n"
#~ "Tylko właściciel procesu oraz superużytkownik\n"
#~ "mają do tego prawo."

#: qps.C:845
msgid "qps: renice process"
msgstr "qps: zmiana priorytetu procesu"

#: qps.C:846
msgid "New nice value:"
msgstr "Nowy priorytet:"

#: qps.C:856
msgid ""
"The nice value should be\n"
"in the range -20 to 20."
msgstr ""
"Priorytet musi się zawierać\n"
"w przedziale -20..20"

#: qps.C:873
#, c-format
msgid ""
"You do not have permission to renice process %d (%s).\n"
"Only the process owner and the super-user are allowed to do that."
msgstr ""
"Brak praw do zmiany priorytetu procesu %d (%s).\n"
"Tylko właściciel procesu oraz superużytkownik mają do tego prawo."

#: qps.C:885
msgid "Only the super-user may lower the nice value of a process."
msgstr "Tylko superużytkownik może zmniejszyć priorytet procesu."

#: qps.C:908
msgid ""
"Only the super-user may change the\n"
"scheduling policy and static priority."
msgstr ""
"Tylko superużytkownik może zmienić\n"
"sposób kolejkowania i nadać priorytet."

#: qps.C:938
#, c-format
msgid ""
"You do not have permission to change the\n"
"scheduling and/or priority of process %d (%s).\n"
"Only the super-user may do that."
msgstr ""
"Brak praw do zmiany sposobu kolejkowania\n"
"procesu %d (%s).\n"
"Tylko superużytkownik ma do tego prawo."

#: qps.C:982
#, c-format
msgid ""
"You do not have permission to send a signal to process %d (%s).\n"
"Only the super-user and the owner of the process may send signals to it."
msgstr ""
"Brak praw do wysłania sygnału do procesu %d (%s).\n"
"Tylko właściciel procesu oraz superużytkownik mają do tego prawo."

#: scheddlg.C:22
msgid "Change scheduling"
msgstr "Zmiana kolejkowania"

#: scheddlg.C:28
msgid "Scheduling Policy"
msgstr "Sposób kolejkowania"

#: scheddlg.C:29
msgid "SCHED_OTHER (time-sharing)"
msgstr "SCHED_OTHER (z podziałem czasu)"

#: scheddlg.C:36
msgid "SCHED_FIFO (real-time)"
msgstr "SCHED_FIFO (czasu rzeczywistego)"

#: scheddlg.C:42
msgid "SCHED_RR (real-time)"
msgstr "SCHED_RR (czasu rzeczywistego)"

#: scheddlg.C:67
msgid "Priority (1-99):"
msgstr "Priorytet (1-99)"

#: scheddlg.C:114
msgid "The priority must be in the range 1..99"
msgstr "Priotytet musi się zawierać w przedziale 1..99"
