#: floppy.cpp:292
#, c-format
msgid ""
"Cannot access %s\n"
"Make sure that the device exists and that\n"
"you have write permission to it."
msgstr ""
"Není možné přistoupit na %s\n"
"Ujistěte se, že zařízení existuje,\n"
"a že máte příslušná práva k zápisu."

#: floppy.cpp:339
msgid ""
"Cannot find kfdformat\n"
"kfdformat is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Není možné nálézt kfdformat\n"
"kfdformat je součástí distribuce formátovače disket.\n"
"Prosím, nainstalujte formátovač disket korektně."

#: floppy.cpp:355
msgid ""
"Cannot find kmke2fs\n"
"kmke2fs is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Není možné nálézt kmke2fs\n"
"kmke2fs je součástí distribuce formátovače disket.\n"
"Prosím, nainstalujte formátovač disket korektně."

#: floppy.cpp:370
msgid ""
"Cannot find kmkdosfs\n"
"kmkdosfs is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Není možné nálézt kmkdosfs\n"
"kmkdosfs je součástí distribce formátovače disket.\n"
"Prosím, nainstalujte formátovač disket korektně."

#: floppy.cpp:430
msgid "Abort"
msgstr "Zrušit"

#: floppy.cpp:478
msgid "Cannot start a new program: fork() failed."
msgstr "Není možné spustit nový program: selhal fork()."

#: floppy.cpp:578 floppy.cpp:706
msgid ""
"Cannot access floppy or floppy drive\n"
"Please insert a floppy and make sure that you\n"
"have selected a valid floppy drive.\n"
msgstr ""
"Není možné přistupovat na disketu nebo na disketovou jednotku.\n"
"Prosím, vložte disketu a ujistěte se, že jste\n"
"vybrali správnou disketovou mechaniku.\n"

#: floppy.cpp:593
#, c-format
msgid ""
"Cannot format: %s\n"
"%s"
msgstr ""
"Není možné formátovat: %s\n"
"%s"

#: floppy.cpp:640
#, c-format
msgid "Block %d is bad. Continuing ..."
msgstr "Blok %d je vadný. Pokračuji ..."

#: floppy.cpp:723
#, c-format
msgid ""
"Cannot create a filesystem on: %s\n"
"%s"
msgstr ""
"Není možné vytvořit souborový systém na: %s\n"
"%s"

#: floppy.cpp:759
#, c-format
msgid ""
"The floppy was sucessfully formatted.\n"
"Blocks marked bad: %d\n"
"Raw Capacity: %d\n"
msgstr ""
"Disketa byla úspešně naformátovaná.\n"
"Bloků označených za vadné: %d\n"
"Hrubá kapacita: %d\n"

#: floppy.cpp:780
msgid "All files were sucessfully erased."
msgstr "Všechny soubory byli úspešně vymazané."

#: floppy.cpp:838
msgid "Creating Filesystem ..."
msgstr "Vytvářím souborový systém ..."

#: floppy.cpp:842
msgid "Verifying ..."
msgstr "Porovnávám ..."

#: floppy.cpp:887
msgid ""
"Cannot start a new program\n"
"fork() failed."
msgstr ""
"Není možné spustit nový program,\n"
"kvůli selhání volání fork()."

#: floppy.cpp:913
msgid "Error while trying to determine whether floppy is mounted\n"
msgstr "Chyba při zjišťování, zda je disketa připojená k systému\n"

#: floppy.cpp:930
#, c-format
msgid ""
"%s is mounted.\n"
"Please unmount the floppy first."
msgstr ""
"%s je připojená.\n"
"Prosím, nejprve odpojte disketu ze systému."
