msgstr "SIGPIPE (pokažená roura)"

#: qps.C:314
msgid "SIGALRM (timer signal)"
msgstr "SIGALRM (signál časovače)"

#: qps.C:315
msgid "SIGUSR1 (user-defined 1)"
msgstr "SIGUSR1 (definované uživatelem 1)"

#: qps.C:316
msgid "SIGUSR2 (user-defined 2)"
msgstr "SIGUSR2 (definované uživatelem 2)"

#: qps.C:317
msgid "SIGCHLD (child death)"
msgstr "SIGCHLD (smrt potomka)"

#: qps.C:318
msgid "SIGCONT (continue)"
msgstr "SIGCONT (pokračovat)"

#: qps.C:319
msgid "SIGSTOP (stop)"
msgstr "SIGSTOP (stop)"

#: qps.C:320
msgid "SIGTSTP (stop from tty)"
msgstr "IGTSTP (stop z tty)"

#: qps.C:321
msgid "SIGTTIN (tty input)"
msgstr "SIGTTIN (tty vstup)"

#: qps.C:322
msgid "SIGTTOU (tty output)"
msgstr "SIGTTOU (tty výstup)"

#: qps.C:622
#, c-format
msgid ""
"You do not have permission to view the\n"
"open sockets of process %d (%s).\n"
"Only the owner of the process and the\n"
"super-user may do that."
msgstr ""
"Nemáte přístupová práva k prohlížení\n"
"otevřených socketů procesu %d (%s).\n"
"Pouze vlastník procesu a superuživatel\n"
"mohou provést tuto operaci."

#: qps.C:627 qps.C:836 qps.C:878 qps.C:884 qps.C:907 qps.C:943 qps.C:987
msgid "Permission denied"
msgstr "Zakázaný přístup"

#: qps.C:700
msgid "qps: change update period"
msgstr "qps: změna periody obnovování"

#: qps.C:701
msgid "New update period:"
msgstr "Nová perioda obnovování:"

#: qps.C:716 qps.C:855 scheddlg.C:113
msgid "Invalid input"
msgstr "Neplatný vstup"

#: qps.C:717
msgid ""
"The time between updates should be a number, optionally followed\n"
"by a unit (ms, s or min). If no unit is given, seconds is assumed."
msgstr ""
"Čas mezi obnovováními by měl být číslo, které je případně následováno \n"
"jednotkou (ms, s nebo min). Není-li uvedeno, budou použity sekundy."

#: qps.C:831
#, c-format
msgid ""
"You do not have permission to renice the\n"
"selected process%s.\n"
"Only the process owner and the super-user\n"
"are allowed to do that."
msgstr ""
"Nemáte přístupová práva ke změně priority\n"
"vybraného procesu %s.\n"
"Pouze vlastník procesu nebo superuživatel\n"
"mohou provést tuto operaci."

#: qps.C:845
msgid "qps: renice process"
msgstr "qps: změna priority"

#: qps.C:846
msgid "New nice value:"
msgstr "Nová hodnata priority:"

#: qps.C:856
msgid ""
"The nice value should be\n"
"in the range -20 to 20."
msgstr "Hodnota by měla být v rozsahu -20 až 20."

#: qps.C:873
#, c-format
msgid ""
"You do not have permission to renice process %d (%s).\n"
"Only the process owner and the super-user are allowed to do that."
msgstr ""
"Nemáte přístupová práva ke změně priority procesu %d (%s).\n"
"Pouze vlastník procesu nebo superuživatel mohou provést tuto operaci."

#: qps.C:885
msgid "Only the super-user may lower the nice value of a process."
msgstr "Pouze superuživatel může snížit hodnotu priority procesu."

#: qps.C:908
msgid ""
"Only the super-user may change the\n"
"scheduling policy and static priority."
msgstr ""
"Pouze superuživatel může změnit\n"
"způsob plánování a statickou prioritu."

#: qps.C:938
#, c-format
msgid ""
"You do not have permission to change the\n"
"scheduling and/or priority of process %d (%s).\n"
"Only the super-user may do that."
msgstr ""
"Nemáte přístupová práva ke změně \n"
"plánování nebo priority procesu %d (%s).\n"
"Tuto operaci může provádět pouze superuživatel."

#: qps.C:982
#, c-format
msgid ""
"You do not have permission to send a signal to process %d (%s).\n"
"Only the super-user and the owner of the process may send signals to it."
msgstr ""
"Nemáte přístupová práva k poslání signálu procesu %d (%s).\n"
"pouze superuživatel nebo vlastník procesu mu mohou posílat signály."

#: scheddlg.C:22
msgid "Change scheduling"
msgstr "Změnit plánování"

#: scheddlg.C:28
msgid "Scheduling Policy"
msgstr "Způsob plánování"

#: scheddlg.C:29
msgid "SCHED_OTHER (time-sharing)"
msgstr "SCHED_OTHER (sdílení času)"

#: scheddlg.C:36
msgid "SCHED_FIFO (real-time)"
msgstr "SCHED_FIFO (reálný čas)"

#: scheddlg.C:42
msgid "SCHED_RR (real-time)"
msgstr "SCHED_RR (reálný čas)"

#: scheddlg.C:67
msgid "Priority (1-99):"
msgstr "Priorita (1-99):"

#: scheddlg.C:114
msgid "The priority must be in the range 1..99"
msgstr "Priorita musí být v rozsahu 1..99"
