msgid ""
"Cannot start a new program\n"
"fork() failed."
msgstr ""
"Nemôžem spustiť nový program\n"
"fork() zlyhal."

#: floppy.cpp:913
msgid "Error while trying to determine whether floppy is mounted\n"
msgstr "Chyba pri zisťovaní, či je disketa pripojená k systému\n"

#: floppy.cpp:930
#, c-format
msgid ""
"%s is mounted.\n"
"Please unmount the floppy first."
msgstr ""
"%s je pripojená.\n"
"Prosím, najprv odpojte disketu zo systému."
