#: floppy.cpp:292
#, c-format
msgid ""
"Cannot access %s\n"
"Make sure that the device exists and that\n"
"you have write permission to it."
msgstr ""
"Nemôžem pristupovať k %s\n"
"Uistite sa, že zariadenie existuje,\n"
"a že máte doň právo zapisovať"

#: floppy.cpp:339
msgid ""
"Cannot find kfdformat\n"
"kfdformat is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Nemôžem nájsť kfdformat\n"
"kfdformat je súčasťou distribúcie Formátovača diskiet.\n"
"Prosím, nainštalujte Formátovač diskiet korektne."

#: floppy.cpp:355
msgid ""
"Cannot find kmke2fs\n"
"kmke2fs is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Nemôžem nájsť kmke2fs\n"
"kmke2fs je súčasťou distribúcie Formátovača diskiet.\n"
"Prosím, nainštalujte Formátovač diskiet korektne."

#: floppy.cpp:370
msgid ""
"Cannot find kmkdosfs\n"
"kmkdosfs is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Nemôžem nájsť kmkdosfs\n"
"kmkdosfs je súčasťou distribúcie Formátovača diskiet.\n"
"Prosím, nainštalujte Formátovač diskiet korektne."

#: floppy.cpp:430
msgid "Abort"
msgstr "Zrušiť"

#: floppy.cpp:478
msgid "Cannot start a new program: fork() failed."
msgstr "Nemôžem spustiť nový program: fork() zlyhal."

#: floppy.cpp:578 floppy.cpp:706
msgid ""
"Cannot access floppy or floppy drive\n"
"Please insert a floppy and make sure that you\n"
"have selected a valid floppy drive.\n"
msgstr ""
"Nemôžem pristupovať k diskete alebo k disketovej jednotke\n"
"Prosím, vložte disketu a uistite sa, že ste\n"
"vybrali správnu disketovú mechaniku.\n"

#: floppy.cpp:593
#, c-format
msgid ""
"Cannot format: %s\n"
"%s"
msgstr ""
"Nemôžem formátovať: %s\n"
"%s"

#: floppy.cpp:640
#, c-format
msgid "Block %d is bad. Continuing ..."
msgstr "Blok %d je vadný. Pokračujem ..."

#: floppy.cpp:723
#, c-format
msgid ""
"Cannot create a filesystem on: %s\n"
"%s"
msgstr ""
"Nemôžem vytvoriť súborový systém na: %s\n"
"%s"

#: floppy.cpp:759
#, c-format
msgid ""
"The floppy was sucessfully formatted.\n"
"Blocks marked bad: %d\n"
"Raw Capacity: %d\n"
msgstr ""
"Disketa bola úspešne naformátovaná.\n"
"Bloky označené ako vadné: %d\n"
"Hrubá kapacita: %d\n"

#: floppy.cpp:780
msgid "All files were sucessfully erased."
msgstr "Všetky súbory boli úspešne vymazané."

#: floppy.cpp:838
msgid "Creating Filesystem ..."
msgstr "Vytváram súborový systém ..."

#: floppy.cpp:842
msgid "Verifying ..."
msgstr "Porovnávam ..."

