#: floppy.cpp:759
#, c-format
msgid ""
"The floppy was sucessfully formatted.\n"
"Blocks marked bad: %d\n"
"Raw Capacity: %d\n"
msgstr ""
"Discheta a fost formatată.\n"
"Blocuri marcate defecte: %d\n"
