#: floppy.cpp:292
#, c-format
msgid ""
"Cannot access %s\n"
"Make sure that the device exists and that\n"
"you have write permission to it."
msgstr ""
"Nu pot accesa %s\n"
"Asigură-te că dispozitivul există şi că\n"
"ai drepturi de scriere pe el."

#: floppy.cpp:339
msgid ""
"Cannot find kfdformat\n"
"kfdformat is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Nu găsesc kfdformat\n"
"kfdformat este parte din distributia KFloppy.\n"
"Instalează KFloppy integral."

#: floppy.cpp:355
msgid ""
"Cannot find kmke2fs\n"
"kmke2fs is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
msgstr ""
"Nu găsesc kmke2fs\n"
"kmke2fs este parte din distributia KFloppy.\n"
"Instalează KFloppy integral."

#: floppy.cpp:370
msgid ""
"Cannot find kmkdosfs\n"
"kmkdosfs is part of the KFloppy distribution.\n"
"Please install KFloppy properly."
